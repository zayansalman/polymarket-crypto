# Copy to .env locally (gitignored).
#
# Names here are exactly what config.py reads. The old BTC_-prefixed names
# (BTC_BOT_MODE, BTC_LIVE_MAX_TRADE_USD, BTC_PAPER_*, ...) are
# IGNORED; the app logs a `config.legacy_env_name` warning at boot for each one
# it finds. Rename them — values are never carried over.

DATA_DIR=./data
DB_PATH=./data/btc_5m_binary_fair_value.db

# Local unauthenticated dashboard bind address.
# Keep 127.0.0.1 unless you deliberately want LAN/container access.
DASHBOARD_SERVER_NAME=127.0.0.1
DASHBOARD_SERVER_PORT=7860

# Active execution target: "paper" (default, simulated only) or "live".
# LIVE PLACES REAL ORDERS WITH REAL FUNDS on the Polymarket CLOB. Live is
# armed by clicking LIVE in the dashboard, and needs POLYMARKET_PRIVATE_KEY
# (plus a coherent wallet below). It never silently falls back to paper.
BOT_MODE=paper
PAPER_MIN_TRADE_USD=1
PAPER_MAX_TRADE_USD=5
PAPER_TICK_SECONDS=5
PAPER_ENTRY_EDGE_MIN=0.045
PAPER_MIN_CONFIDENCE=0.50
PAPER_ENTRY_MIN_REMAINING_SECONDS=60
PAPER_TARGET_RETURN=0.10
PAPER_STOP_RETURN=-0.08
PAPER_TIME_EXIT_SECONDS=45

# Optional exported Polymarket CSV used only for sizing context.
HISTORY_CSV_PATH=./data/polymarket_history.csv

# Binance market-data endpoint. api.binance.com is unreachable from some
# networks; the .vision mirror serves identical /api/v3 market-data routes.
BINANCE_API_BASE=https://data-api.binance.vision

# Settlement-aligned Chainlink feed. Seconds after which the latest print is
# stale (a stale feed blocks NEW entries; exits still run), and the observed
# print granularity used to estimate the close == open tie mass.
#CHAINLINK_STALE_SECONDS=15
#PRINT_GRANULARITY_USD=0.01
#POLYMARKET_CRYPTO_PRICE_API=https://polymarket.com/api/crypto/crypto-price
#POLYMARKET_LIVE_DATA_WS=wss://ws-live-data.polymarket.com

# --- Live trading (Polymarket CLOB) -----------------------------------------
# Only read when BOT_MODE=live. Keep the key OUT of git; this file ships
# with both wallet values empty on purpose.
#POLYMARKET_CLOB_API=https://clob.polymarket.com
#POLYMARKET_CHAIN_ID=137

# Polygon wallet private key used to sign CLOB orders. NEVER commit or log it.
POLYMARKET_PRIVATE_KEY=
# Funder (proxy / deposit wallet) address that holds your USDC on Polymarket.
# REQUIRED for signature types 1, 2 and 3 — live boot REFUSES without it,
# because orders signed without a funder are rejected by the CLOB. Leave empty
# only for a plain EOA (type 0).
POLYMARKET_FUNDER=
# Signature type — must match how the funder wallet was created:
#   0 = EOA (the key's own address holds the funds)
#   1 = email/Magic proxy wallet (POLY_PROXY) — config default
#   2 = Gnosis Safe (connected browser wallet, e.g. MetaMask)
#   3 = deposit wallet / ERC-1271 (created by tools/live_setup.py)
# tools/live_detect_wallet.py detects 0/1/2 from your key; tools/live_setup.py
# writes 3. There is no key export in the Polymarket UI — see the runbook
# (docs/OPERATIONS_RUNBOOK.md, "Going live").
POLYMARKET_SIGNATURE_TYPE=1

# Hard risk limits, enforced by the unified RiskGate before EVERY entry, paper
# or live (same values both modes). NOTE: a typo in any of these (e.g. "O.50")
# makes live mode REFUSE to boot instead of silently trading on the looser
# default.
# Max USD notional per single trade.
TRADE_MAX_USD=3
# Halt all new entries for the rest of the UTC day once realized PnL is at
# or below minus this amount. PERSISTED in SQLite — restarting the bot does
# NOT reset the counter within the same UTC day.
TRADE_DAILY_LOSS_HALT_USD=10
# OPTIONAL cap on the SUM of all buy notionals per UTC day. Leave blank
# (or unset, or set to 0) to DISABLE the cap — the bot trades each new edge
# without a daily budget ceiling. When set to a positive dollar amount the
# counter is persisted in SQLite, so Stop/Start does not grant a fresh
# bankroll within the same UTC day. The daily-spend tracker keeps running
# either way so the dashboard can show throughput when the cap is off.
TRADE_BANKROLL_CAP_USD=
# Block an entry when the live best ask sits more than this far above the
# signal price that produced the edge (thin 5m books can gap badly).
TRADE_MAX_ENTRY_SLIPPAGE=0.02
# How long an exit SELL may rest before it is cancelled and retried at the
# new best bid (exit orders never rest beyond this bound).
LIVE_EXIT_FILL_TIMEOUT_SECONDS=10

# Kill switch: create this file (e.g. `touch data/KILL`) to immediately block
# all NEW entries and cancel resting orders. Open positions are still
# flattened by the exit path — flattening only reduces exposure. Delete the
# file to re-arm; touching it again later triggers the cancel sweep again.
#KILL_SWITCH_PATH=./data/KILL

# Trade shape: 'settle' (default — one entry per window, hold to Chainlink
# resolution, spread paid once; winners need operator redemption in the UI)
# or 'scalp' (legacy intra-window exits; lost money under honest fills).
EXIT_STYLE=settle

# Shadow forward-tester: log candidate strategies' would-be trades alongside
# the live strategy (no orders placed). "off" disables it.
#SHADOW_ENABLED=on

# Anti-adverse-selection entry filters (issue #29, from 26h soak n=225):
# reject "too good" edges (stale model) and longshot entries below 50c.
PAPER_ENTRY_EDGE_MAX=0.07
PAPER_MIN_ENTRY_PRICE=0.50

# Adaptive risk controller (issue #36): pause new entries on edge decay.
AUTO_PAUSE_ENABLED=true
AUTO_PAUSE_WINDOW=20
AUTO_PAUSE_MIN_TRADES=10
AUTO_PAUSE_MIN_ROI=-0.15

# Daily altcoin Up/Down shadow strategy (issue #185). Paper-only, no live gate.
#DAILY_ASSETS=doge,sol,xrp,bnb,eth
#DAILY_TRADE_USD=10
#DAILY_SCAN_INTERVAL_SECONDS=60
#DAILY_ENTRY_EDGE_MIN=0.045
#DAILY_ENTRY_MIN_REMAINING_SECONDS=3600
#DAILY_VOL_LOOKBACK_DAYS=30
