# Copy to .env locally (gitignored).

DATA_DIR=./data
DB_PATH=./data/btc_5m_binary_fair_value.db

# Local unauthenticated dashboard bind address.
# Keep 127.0.0.1 unless you deliberately want LAN/container access.
DASHBOARD_SERVER_NAME=127.0.0.1
DASHBOARD_SERVER_PORT=7860

# The PAPER/LIVE selection until one is picked in the dashboard. "live" here is
# never consent to trade: live orders need LIVE clicked in the dashboard in this
# process, a wallet that passes, and the strategy's switch on (AGENTS.md, "Live
# trading"). Only Kelly horse-race has a live path; Fade places nothing while
# LIVE is selected.
BOT_MODE=paper

# The live venue's wallet (Kelly horse-race only; needs `pip install -e ".[live]"`).
# Never commit these. Signature type 2 (the Polymarket Safe) is the only setup the
# live venue accepts; the funder is your Polymarket wallet address.
#POLYMARKET_PRIVATE_KEY=
#POLYMARKET_FUNDER=
#POLYMARKET_SIGNATURE_TYPE=2
#POLYMARKET_CHAIN_ID=137

# Every strategy knob lives in the dashboard's SETTINGS card — edit it there.
# Changes apply on the strategy's next pass, no restart, and are logged to the
# activity feed. See ems/runtime_knobs.py for the list and defaults.

# Binance market-data endpoint. api.binance.com is unreachable from some
# networks; the .vision mirror serves identical /api/v3 market-data routes.
BINANCE_API_BASE=https://data-api.binance.vision

# Kill switch: create this file (e.g. `touch data/KILL`) to stop every
# strategy placing new orders and cancel its resting ones. Delete the file to
# re-arm.
#KILL_SWITCH_PATH=./data/KILL
